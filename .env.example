# AgriConnect Root Environment Variables
PROJECT_NAME=AgriConnect
ENVIRONMENT=development

# Database Configuration
# Default (Zero-config SQLite for local dev):
DATABASE_URL=sqlite+aiosqlite:///./agriconnect.db
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://agriadmin:agripass123@localhost:5432/agriconnect_db

# Security & JWT Tokens
SECRET_KEY=super_secret_jwt_key_agriconnect_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML Thresholds & Version
MODEL_VERSION=v1.0
DISEASE_CONFIDENCE_THRESHOLD=0.60

# Payment Gateway (Razorpay Test Keys)
RAZORPAY_KEY_ID=rzp_test_agriconnect_sample
RAZORPAY_KEY_SECRET=dummy_razorpay_secret

# Cloudinary (Optional, local upload fallback active)
CLOUDINARY_URL=

# Default Admin Credentials for Seeding
DEFAULT_ADMIN_EMAIL=admin@agriconnect.test
DEFAULT_ADMIN_PASSWORD=admin123

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_agriconnect_sample
